# ─── Runtime ────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────────────────────────────────
# Local development: SQLite file (no server needed).
DATABASE_URL=sqlite:///./storage/govpii.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+psycopg://govpii:CHANGE_ME@db-host:5432/govpii

# ─── Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ───
JWT_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_characters
PII_HASH_KEY=CHANGE_ME_a_different_random_value_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false                # must be true in production (HTTPS)

# ─── Uploads & storage ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=52428800           # bytes (50 MB)
ALLOWED_FILE_TYPES=pdf,docx,xlsx,csv,txt,json,xml,png,jpg,tiff
UPLOAD_DIRECTORY=./storage/documents
TEMP_DIRECTORY=./storage/tmp
MAX_PAGE_COUNT=500
MAX_OCR_PAGES=50
MAX_PROCESSING_SECONDS=300

# ─── OCR / NER ──────────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGE=eng+hin+tel        # language packs that aren't installed are skipped
OCR_TIMEOUT=60
# Pages recognised in parallel; 0 = automatic (up to 4, one per CPU core)
OCR_WORKERS=0
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if not on PATH
NER_ENABLED=true
SPACY_MODEL=en_core_web_md
# Photos, QR codes and barcodes, signatures in PDFs and images (needs opencv-python-headless)
VISUAL_DETECTION_ENABLED=true

# ─── Background processing ──────────────────────────────────────────────────
# inline: thread pool inside the API process (no broker needed)
# celery: RabbitMQ + Celery workers
TASK_EXECUTION=inline
INLINE_WORKER_THREADS=2
CELERY_BROKER_URL=amqp://govpii:CHANGE_ME@localhost:5672//
CELERY_RESULT_BACKEND=

# ─── HTTP ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_UPLOAD=30/60
RATE_LIMIT_SCAN=30/60
RATE_LIMIT_REDACTION=20/60
RATE_LIMIT_REPORT=60/60
RATE_LIMIT_REVEAL=10/60

# ─── Public uploads (no sign-in) ────────────────────────────────────────────
PUBLIC_UPLOADS_ENABLED=true
PUBLIC_RETENTION_HOURS=24          # anonymous uploads and their results are deleted after this
RATE_LIMIT_PUBLIC_UPLOAD=20/3600   # per client IP
RATE_LIMIT_PUBLIC_POLL=240/60

# ─── First administrator (scripts/create_admin.py; only administrators sign in) ─
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
