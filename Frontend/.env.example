# api | mock
VITE_API_MODE=api
# Base URL for the FastAPI backend (same origin recommended so HTTP-only cookies work)
VITE_API_BASE_URL=/api/v1
# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000
# Maximum upload size in megabytes (must match the backend limit)
VITE_MAX_UPLOAD_MB=50
# Dev server only: proxy /api to this backend
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
